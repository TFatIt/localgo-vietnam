# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# Google Gemini AI Configuration
# Điền API Key của bạn từ https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration (Tùy chọn phụ trợ)
OPENAI_API_KEY=

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/localgo-vietnam

# JWT Authentication
JWT_SECRET=localgo_vietnam_secret_jwt_key_super_secure_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=localgo_vietnam_refresh_secret_key_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (Ảnh đại diện & bài viết)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps API Key
GOOGLE_MAPS_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# CORS
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000,exp://
LOG_LEVEL=info
